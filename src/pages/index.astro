---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import CallbackForm from '../components/CallbackForm.astro';
import home from '../data/home.json';
import branches from '../data/branches.json';
import prices from '../data/prices.json';
import faq from '../data/faq.json';
import settings from '../data/settings.json';
import { url, rub } from '../lib/util';

const directions = (await getCollection('directions')).sort((a, b) => a.data.order - b.data.order);
const cats = ['Детям', 'Взрослым', 'Фитнес', '60+'].map((c) => ({ title: c === 'Взрослым' ? 'Танцы для взрослых' : c === 'Фитнес' ? 'Фитнес и тело' : c, cat: c, items: directions.filter((d) => d.data.category === c) }));
const slideBg: Record<string, string> = { rose: 'var(--rose)', soft: 'var(--rose-soft)', blush: 'var(--blush)' };
const adults = prices.groups.find((g) => g.name === 'Взрослые');
const kids = prices.groups.find((g) => g.name === 'Дети');
const kompl = prices.groups.find((g) => g.name.startsWith('Комплекс'));
const eight = (g: any) => g?.plans.find((p: any) => p.title === '8 занятий')?.price ?? 0;
const plans = [
  { title: 'Пробное занятие', sub: 'дети / взрослые', price: 'от ' + rub(kids?.plans[0].price ?? 300), note: '−15% на абонемент в тот же день', hl: true },
  { title: 'Дети — 8 занятий', sub: 'занятие 1 час', price: rub(eight(kids)), note: '30 дней, оба филиала' },
  { title: 'Комплекс — 8 занятий', sub: 'дети, 1,5 часа', price: rub(eight(kompl)), note: '30 дней, оба филиала' },
  { title: 'Взрослые — 8 занятий', sub: 'все направления', price: rub(eight(adults)), note: '30 дней, оба филиала' }
];
const promoBg = ['var(--rose)', 'var(--rose-soft)', 'var(--blush)', 'var(--rose-soft)'];
---
<Base title={settings.full_name} active="home">

  <!-- Промо-слайдер -->
  <section class="wrap hero-wrap">
    <div class="slider" data-slider>
      <div class="slides" data-track>
        {home.slides.map((s, i) => (
          <article class="slide" style={`background:${slideBg[s.color] || 'var(--rose)'}`} aria-roledescription="слайд" aria-label={`${i + 1} из ${home.slides.length}`}>
            <div class="slide-text">
              <span class="slide-tag">{s.tag}</span>
              {i === 0 ? <h1 class="h1">{s.title}</h1> : <h2 class="h1">{s.title}</h2>}
              <p class="slide-p">{s.text}</p>
              <div class="slide-btns">
                <a href={url(s.link)} class="btn btn-primary">{s.button}</a>
                <a href={url('/filialy/')} class="btn btn-light">Выбрать филиал</a>
              </div>
            </div>
            <div class="slide-media">
              <Img src={s.image} alt={s.title} label="Фото: светлый зал, группа в движении" class="slide-img" bg="var(--milk)" />
            </div>
          </article>
        ))}
      </div>
      <div class="dots" role="group" aria-label="Слайды">
        {home.slides.map((_, i) => <button type="button" class="dot" data-dot={i} aria-label={`Слайд ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
      </div>
    </div>
  </section>

  <!-- Быстрый выбор -->
  <section class="wrap" style="padding-top:24px">
    <div class="grid" style="--min:250px; gap:16px">
      {home.audiences.map((a) => (
        <a href={url('/napravleniya/?cat=' + encodeURIComponent(a.category))} class="aud card">
          <span class="aud-top"><span class="aud-title">{a.title}</span><span class="aud-arrow" aria-hidden="true">→</span></span>
          <span class="script aud-note">{a.note}</span>
          <span class="muted aud-text">{a.text}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Цифры -->
  <section class="wrap" style="padding-top:24px">
    <div class="stats">
      {home.stats.map((s) => <div><div class="stat-v">{s.value}</div><div class="muted stat-l">{s.label}</div></div>)}
    </div>
  </section>

  <!-- Филиалы -->
  <section class="wrap section">
    <div class="row-head"><h2 class="h2">Два филиала, семь залов</h2><a href={url('/filialy/')} class="link-more">Всё о филиалах →</a></div>
    <div class="grid" style="--min:420px">
      {branches.items.map((b, i) => (
        <article class="card branch">
          <Img src={b.photos[0]} alt={`Зал на ${b.name}`} label="Фото зала" class="branch-img" bg={i ? 'var(--rose)' : 'var(--rose-soft)'} />
          <div class="branch-body">
            <div class="eyebrow">Филиал</div>
            <h3 class="branch-name">{b.name}</h3>
            <p class="muted branch-meta">{b.halls.length} {b.halls.length > 4 ? 'залов' : 'зала'}: {b.halls.join(', ').toLowerCase()}<br>{b.hours}</p>
            <a href={url('/raspisanie/')} class="btn btn-dark">Расписание филиала</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Абонементы -->
  <section class="wrap section">
    <div class="row-head">
      <div><h2 class="h2">Абонементы</h2><p class="muted" style="margin-top:8px">Один абонемент — все направления в обоих филиалах.</p></div>
      <a href={url('/abonementy/')} class="link-more">Все абонементы →</a>
    </div>
    <div class="grid" style="--min:250px; gap:16px">
      {plans.map((p) => (
        <a href={url('/abonementy/')} class="plan" style={`background:${p.hl ? 'var(--rose)' : 'var(--white)'}`}>
          <span class="plan-t">{p.title}</span>
          <span class="muted plan-s">{p.sub}</span>
          <span class="plan-p">{p.price}</span>
          <span class="plan-n">{p.note}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Направления -->
  <section class="wrap section">
    <div class="row-head"><h2 class="h2">{directions.length}+ направлений</h2><a href={url('/napravleniya/')} class="link-more">Каталог направлений →</a></div>
    <div class="grid" style="--min:260px">
      {cats.map((c) => (
        <div class="cat">
          <a href={url('/napravleniya/?cat=' + encodeURIComponent(c.cat))} class="cat-t">{c.title}</a>
          <div class="chips">
            {c.items.map((d) => <a href={url('/napravleniya/' + d.id + '/')} class="chip">{d.data.title}</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Идея бренда -->
  <section class="section">
    <div class="idea">
      <div class="wrap idea-in">
        <img src={url('/uploads/logo-white.png')} alt="Свети — Танцуй Люби" class="idea-logo" width="420" height="137" loading="lazy">
        <blockquote class="idea-q">
          <p>{home.quote}</p>
          <footer>{home.quote_author}</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Акции -->
  <section id="promo" class="wrap section">
    <h2 class="h2" style="margin-bottom:32px">Акции и скидки</h2>
    <div class="grid" style="--min:250px; gap:16px">
      {prices.discounts.map((k, i) => (
        <div class="promo" style={`background:${promoBg[i % 4]}`}>
          <div class="promo-v">{k.value}</div>
          <div class="promo-t">{k.title}</div>
          <div class="promo-x">{k.text}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Жизнь студии -->
  <section id="events" class="wrap section">
    <div class="row-head"><h2 class="h2">Жизнь студии</h2><a href={settings.vk} class="link-more" rel="noopener">Все новости во ВКонтакте →</a></div>
    <div class="grid" style="--min:300px">
      {home.events.map((e, i) => (
        <a href={e.link} class="event" rel="noopener">
          <Img src={e.image} alt={e.title} label="Фото" class="event-img" bg={['var(--rose-soft)', 'var(--rose)', 'var(--blush)'][i % 3]} />
          <span class="tag">{e.tag}</span>
          <span class="event-t">{e.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="wrap section faq">
    <div class="faq-l">
      <h2 class="h2">Вопросы и ответы</h2>
      <p class="muted" style="margin-top:12px">Не нашли ответ? Позвоните: <a href={'tel:' + settings.phone.replace(/[^+\d]/g, '')}>{settings.phone}</a></p>
    </div>
    <div class="faq-r">
      {faq.items.map((q, i) => (
        <details class="qa" open={i === 0}>
          <summary>{q.q}<span aria-hidden="true" class="qa-sign"></span></summary>
          <p class="muted">{q.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="wrap section section-last">
    <CallbackForm context="Главная" />
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const n = dots.length;
    let i = 0, timer: number | undefined;
    const go = (k: number) => { i = (k + n) % n; track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' }); };
    const mark = () => { const k = Math.round(track.scrollLeft / track.clientWidth); i = k; dots.forEach((d, j) => d.setAttribute('aria-current', String(j === k))); };
    dots.forEach((d, j) => d.addEventListener('click', () => { go(j); restart(); }));
    track.addEventListener('scroll', () => window.requestAnimationFrame(mark), { passive: true });
    const restart = () => { if (timer) clearInterval(timer); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => go(i + 1), 7000); };
    root.addEventListener('pointerenter', () => timer && clearInterval(timer));
    root.addEventListener('pointerleave', restart);
    restart();
  });
</script>

<style>
  .hero-wrap { padding-top: 24px; }
  .slider { position: relative; }
  .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; border-radius: var(--r-xl); scrollbar-width: none; }
  .slides::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; display: flex; flex-wrap: wrap; min-height: 460px; }
  .slide-text { flex: 1 1 440px; padding: 56px 56px 72px; display: flex; flex-direction: column; justify-content: center; gap: 20px; }
  .slide-tag { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; background: var(--milk); color: var(--berry-deep); }
  .slide-p { font-size: 18px; line-height: 28px; max-width: 480px; }
  .slide-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .slide-media { flex: 1 1 340px; display: flex; align-items: flex-end; justify-content: center; padding: 40px 40px 0; }
  :global(.slide-img) { width: 100%; max-width: 420px; height: 400px; border-radius: 220px 220px 0 0; }
  .dots { position: absolute; left: 56px; bottom: 24px; display: flex; gap: 8px; }
  .dot { width: 12px; height: 12px; border-radius: 999px; border: 0; padding: 0; background: var(--milk); cursor: pointer; transition: width .2s; }
  .dot[aria-current="true"] { width: 32px; background: var(--ink); }

  .aud { display: flex; flex-direction: column; gap: 6px; padding: 24px; text-decoration: none; color: var(--ink); min-height: 160px; }
  .aud:hover { border-color: var(--rose); color: var(--ink); }
  .aud-top { display: flex; justify-content: space-between; align-items: center; }
  .aud-title { font-family: var(--f-display); font-size: 30px; line-height: 34px; font-weight: 600; }
  .aud-arrow { width: 40px; height: 40px; border-radius: 999px; background: var(--blush); display: inline-flex; align-items: center; justify-content: center; color: var(--berry); font-weight: 700; }
  .aud-note { font-size: 22px; color: var(--berry-deep); }
  .aud-text { font-size: 14px; line-height: 21px; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; background: var(--blush); border-radius: var(--r-lg); padding: 28px 32px; }
  .stat-v { font-family: var(--f-display); font-size: 48px; line-height: 1; font-weight: 600; }
  .stat-l { font-size: 15px; margin-top: 4px; }

  .branch { display: flex; flex-wrap: wrap; overflow: hidden; }
  :global(.branch-img) { flex: 1 1 200px; min-height: 240px; }
  .branch-body { flex: 1 1 220px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .branch-name { font-size: 22px; line-height: 30px; }
  .branch-meta { font-size: 14px; line-height: 21px; flex-grow: 1; }

  .plan { display: flex; flex-direction: column; gap: 6px; padding: 28px; border-radius: var(--r-lg); border: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .plan:hover { color: var(--ink); border-color: var(--rose); }
  .plan-t { font-weight: 700; }
  .plan-s { font-size: 14px; }
  .plan-p { font-family: var(--f-display); font-size: 46px; line-height: 1.1; font-weight: 600; margin-top: 10px; }
  .plan-n { font-size: 14px; font-weight: 600; }

  .cat { padding: 24px; border-radius: var(--r-lg); background: var(--blush); display: flex; flex-direction: column; gap: 12px; }
  .cat-t { font-size: 18px; font-weight: 700; color: var(--ink); text-decoration: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: 14px; line-height: 20px; padding: 8px 12px; border-radius: 999px; background: var(--white); color: var(--ink); text-decoration: none; font-weight: 500; }
  .chip:hover { background: var(--rose-soft); color: var(--ink); }

  .idea { background: var(--rose); }
  .idea-in { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 80px; padding-top: 88px; padding-bottom: 88px; }
  .idea-logo { flex: 0 1 400px; width: 100%; max-width: 400px; height: auto; }
  .idea-q { flex: 1 1 440px; margin: 0; }
  .idea-q p { font-family: var(--f-display); font-size: clamp(26px, 3vw, 36px); line-height: 1.25; font-weight: 500; }
  .idea-q footer { margin-top: 20px; font-size: 15px; font-weight: 600; }

  .promo { display: flex; flex-direction: column; gap: 8px; padding: 28px; border-radius: var(--r-lg); min-height: 200px; }
  .promo-v { font-family: var(--f-display); font-size: 60px; line-height: 1; font-weight: 600; }
  .promo-t { font-size: 18px; font-weight: 700; }
  .promo-x { font-size: 14px; line-height: 21px; }

  .event { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: var(--ink); align-items: flex-start; }
  :global(.event-img) { width: 100%; height: 240px; border-radius: var(--r-lg); }
  .event-t { font-size: 20px; line-height: 28px; font-weight: 700; }

  .faq { display: flex; flex-wrap: wrap; gap: 32px 64px; }
  .faq-l { flex: 1 1 280px; }
  .faq-r { flex: 2 1 520px; min-width: 0; }
  .qa { border-top: 1px solid var(--line); }
  .qa summary { list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 22px 0; font-weight: 700; font-size: 18px; line-height: 26px; cursor: pointer; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa-sign::before { content: '+'; color: var(--berry); font-size: 24px; }
  .qa[open] .qa-sign::before { content: '−'; }
  .qa p { padding: 0 0 22px; max-width: 680px; }

  @media (max-width: 640px) {
    .slide { min-height: 0; }
    .slide-text { padding: 32px 20px 64px; }
    .slide-media { display: none; }
    .dots { left: 20px; }
    :global(.branch-img) { min-height: 180px; }
    .stats { padding: 20px; }
    .stat-v { font-size: 38px; }
  }
</style>
