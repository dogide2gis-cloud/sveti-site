---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import branches from '../data/branches.json';
import settings from '../data/settings.json';
import { url } from '../lib/util';
const tel = 'tel:' + settings.phone.replace(/[^+\d]/g, '');
---
<Base title="Филиалы" active="branches" description="Филиалы студии танца «Свети» в Магнитогорске: ул. Комсомольская, 16 и ул. Советская, 161. Семь светлых залов, абонемент действует в обоих.">
  <section class="wrap" style="padding-top:32px">
    <nav class="crumbs" aria-label="Хлебные крошки"><a href={url('/')}>Главная</a> / Филиалы</nav>
    <h1 class="h1">Филиалы</h1>
    <p class="muted" style="margin:8px 0 28px; max-width:620px">Два филиала в Магнитогорске и семь светлых залов. Абонемент действует в обоих.</p>
    <div class="pills" role="tablist" aria-label="Филиал">
      {branches.items.map((b, i) => <button type="button" class="pill" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-pressed={i === 0 ? 'true' : 'false'} data-tab={i}>{b.name}</button>)}
    </div>
  </section>

  {branches.items.map((b, i) => (
    <div role="tabpanel" hidden={i !== 0} data-panel={i}>
      <section class="wrap br" style="padding-top:32px">
        <div class="br-l">
          <h2 class="h2">{b.address}</h2>
          <div>
            {[['Часы работы', b.hours], ['Телефон', settings.phone], ['Как добраться', b.how_to_get], ['Парковка', b.parking]].map(([k, v]) => (
              <div class="info"><div class="muted info-k">{k}</div><div class="info-v">{k === 'Телефон' ? <a href={tel}>{v}</a> : v}</div></div>
            ))}
          </div>
          <div>
            <div class="eyebrow" style="margin-bottom:10px">Залы</div>
            <div class="halls">{b.halls.map((h) => <span class="hall">{h}</span>)}</div>
          </div>
          <div class="btns">
            <a href={url('/raspisanie/')} class="btn btn-primary">Расписание филиала</a>
            <a href={`https://yandex.ru/maps/?text=${encodeURIComponent(b.map_query)}`} class="btn btn-ghost" target="_blank" rel="noopener">Построить маршрут</a>
          </div>
        </div>
        <div class="map">
          <iframe src={`https://yandex.ru/map-widget/v1/?text=${encodeURIComponent(b.map_query)}&z=16`} title={`Карта: ${b.address}`} loading="lazy"></iframe>
        </div>
      </section>
      <section class="wrap section">
        <h2 class="h2" style="margin-bottom:24px">Как выглядят залы</h2>
        <div class="gal">
          {[0, 1, 2, 3, 4].map((k) => (
            <Img src={b.photos[k]} alt={`Зал, ${b.name}`} label={k === 0 ? 'Фото: главный зал' : 'Фото зала'} class={k === 0 ? 'arch g-main' : 'g-cell'} bg={['var(--rose)', 'var(--rose-soft)', 'var(--blush)', 'var(--blush)', 'var(--rose-soft)'][k]} style="border-radius:var(--r-lg)" />
          ))}
        </div>
      </section>
    </div>
  ))}
  <div class="section-last"></div>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.setAttribute('aria-pressed', String(on)); });
    panels.forEach((p) => { p.hidden = p.dataset.panel !== t.dataset.tab; });
  }));
</script>

<style>
  .br { display: flex; flex-wrap: wrap; gap: 32px 48px; }
  .br-l { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .info { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 14px 0; border-top: 1px solid var(--line); font-size: 15px; }
  .info-k { min-width: 130px; }
  .info-v { font-weight: 600; }
  .halls { display: flex; flex-wrap: wrap; gap: 8px; }
  .hall { font-size: 14px; font-weight: 600; padding: 8px 14px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .map { flex: 1 1 440px; min-height: 420px; border-radius: var(--r-lg); overflow: hidden; background: #F3EEF0; }
  .map iframe { width: 100%; height: 100%; min-height: 420px; border: 0; display: block; }
  .gal { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  :global(.g-main) { grid-row: span 2; min-height: 520px; border-radius: var(--r-arch) !important; }
  :global(.g-cell) { min-height: 252px; }
  @media (max-width: 640px) { :global(.g-main) { grid-row: auto; min-height: 360px; } :global(.g-cell) { min-height: 200px; } }
</style>
