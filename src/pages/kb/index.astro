---
import { getCollection } from 'astro:content';
import Kb from '../../layouts/Kb.astro';
import { url } from '../../lib/util';
import { roleLabel, sectionOrder, dateRu } from '../../lib/kb';

const all = (await getCollection('kb', (a) => !a.data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ru'));
const sections = [...new Set(all.map((a) => a.data.section))].sort((a, b) => sectionOrder(a) - sectionOrder(b));
---
<Kb title="Главная">
  <div class="kb-hero">
    <div class="kb-hero-t">
      <div class="eyebrow">Для сотрудников студии</div>
      <h1 class="h1">База знаний</h1>
      <p class="muted kb-lead">Регламенты, скрипты, шпаргалки и обучающие материалы. Выберите свою должность вверху — останутся только ваши разделы.</p>
      <label class="field kb-search">
        <span class="sr-only">Поиск</span>
        <input type="search" placeholder="Поиск по статьям" data-search autocomplete="off">
      </label>
      <div class="script kb-script">помогаем сиять другим</div>
    </div>
    <div class="kb-hero-arch" aria-hidden="true"><img src={url('/uploads/logo-ink.png')} alt=""></div>
  </div>

  <div class="kb-pick" data-pick-role>
    <strong>Кто вы?</strong> Выберите должность вверху страницы — и база покажет только нужное. Пока показаны все материалы.
  </div>

  {sections.map((s) => (
    <section class="kb-sec" data-section>
      <h2 class="kb-sec-t">{s}</h2>
      <div class="grid kb-grid" style="--min: 300px">
        {all.filter((a) => a.data.section === s).map((a) => (
          <a class="card kb-card" href={url('/kb/' + a.id + '/')} data-roles={a.data.roles.join(' ')} data-text={(a.data.title + ' ' + a.data.summary).toLowerCase()}>
            <h3>{a.data.title}</h3>
            {a.data.summary && <p class="muted">{a.data.summary}</p>}
            <div class="kb-meta">
              <span class="kb-tags">{a.data.roles.map((r) => <span class="tag">{roleLabel(r)}</span>)}</span>
              {a.data.files.length > 0 && <span class="kb-pdf">PDF</span>}
            </div>
            {a.data.updated && <div class="kb-date">Обновлено {dateRu(a.data.updated)}</div>}
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="muted kb-empty" data-empty hidden>Ничего не нашлось. Попробуйте другое слово.</p>
</Kb>

<script is:inline>
  (function () {
    var input = document.querySelector('[data-search]');
    var empty = document.querySelector('[data-empty]');
    function run() {
      var q = (input.value || '').trim().toLowerCase();
      var role = document.documentElement.dataset.role || '';
      var shown = 0;
      document.querySelectorAll('.kb-card').forEach(function (c) {
        var roleOk = !role || role === 'leader' || c.dataset.roles.split(' ').indexOf(role) >= 0;
        var ok = roleOk && (!q || c.dataset.text.indexOf(q) >= 0);
        c.hidden = !ok; if (ok) shown++;
      });
      document.querySelectorAll('[data-section]').forEach(function (s) { s.hidden = !s.querySelector('.kb-card:not([hidden])'); });
      empty.hidden = shown > 0;
    }
    input.addEventListener('input', run);
    document.addEventListener('kb-role', run);
    run();
  })();
</script>

<style>
  .kb-hero { position: relative; overflow: hidden; display: flex; gap: 32px; align-items: center; justify-content: space-between; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 40px; margin-bottom: 28px; }
  .kb-hero::before { content: ""; position: absolute; right: -100px; top: -140px; width: 440px; height: 440px; border-radius: 50%; background: var(--blush); }
  .kb-hero-t { position: relative; max-width: 620px; }
  .kb-lead { margin-top: 12px; }
  .kb-search { width: min(100%, 420px); margin-top: 20px; }
  .kb-script { font-size: 30px; color: var(--berry); margin-top: 14px; line-height: 1; }
  .kb-hero-arch { position: relative; flex: none; width: 230px; height: 240px; border-radius: 115px 115px 18px 18px; background: var(--rose); display: flex; align-items: center; justify-content: center; }
  .kb-hero-arch img { width: 180px; }
  @media (max-width: 860px) { .kb-hero { padding: 24px 20px; border-radius: var(--r-lg); } .kb-hero-arch { display: none; } .kb-hero::before { width: 240px; height: 240px; right: -100px; top: -120px; } }
  .kb-pick { background: var(--white); border: 1px dashed var(--berry); border-radius: var(--r-lg); padding: 16px 20px; margin-bottom: 32px; font-size: 15px; }
  .kb-sec { margin-top: 40px; }
  .kb-sec-t { font-family: var(--f-display); font-weight: 600; font-size: 32px; margin-bottom: 16px; display: flex; align-items: center; gap: 14px; }
  .kb-sec-t::before { content: ""; flex: none; width: 14px; height: 30px; border-radius: 7px 7px 2px 2px; background: var(--rose); }
  .kb-card { display: flex; flex-direction: column; gap: 10px; padding: 22px; text-decoration: none; color: var(--ink); transition: border-color .15s, transform .15s; }
  .kb-card:hover { border-color: var(--berry); color: var(--ink); transform: translateY(-2px); }
  .kb-card h3 { font-family: var(--f-display); font-size: 25px; font-weight: 600; line-height: 1.15; }
  .kb-card p { font-size: 15px; line-height: 1.5; }
  .kb-meta { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: auto; padding-top: 6px; }
  .kb-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .kb-pdf { font-size: 12px; font-weight: 700; color: var(--white); background: var(--berry); border-radius: var(--r-sm); padding: 4px 8px; }
  .kb-date { font-size: 12px; color: var(--ink-muted); }
  .kb-empty { margin-top: 24px; }
</style>
