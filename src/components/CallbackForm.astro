---
// Форма заявки. Пока сайт на демо-адресе, отправка не подключена:
// после переезда на хостинг заявки будут приходить в Telegram/на почту.
import { url } from '../lib/util';
interface Props { title?: string; text?: string; button?: string; variant?: 'rose' | 'light'; withName?: boolean; context?: string }
const { title = 'Поможем выбрать направление', text = 'Оставьте телефон — администратор перезвонит и запишет на пробное.', button = 'Жду звонка', variant = 'rose', withName = false, context = '' } = Astro.props;
---
<form class={`cb cb-${variant}`} data-callback data-context={context}>
  <div class="cb-text">
    <h2 class="cb-title">{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cb-fields">
    {withName && (
      <label class="field">Имя<input type="text" name="name" autocomplete="name" placeholder="Как к вам обращаться"></label>
    )}
    <label class="field">Телефон<input type="tel" name="phone" autocomplete="tel" required placeholder="+7 (___) ___-__-__"></label>
    <label class="check"><input type="checkbox" name="consent" required><span>Согласен(на) на обработку персональных данных в соответствии с <a href={url('/politika/')}>политикой</a></span></label>
    <button type="submit" class="btn btn-dark">{button}</button>
    <p class="cb-done" role="status" hidden>Спасибо! Это демо-версия сайта — после запуска заявка уйдёт администратору. А пока позвоните: <a href="tel:+79525205434">+7 (952) 520-54-34</a></p>
  </div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-callback]').forEach((f) => {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const done = f.querySelector<HTMLElement>('.cb-done');
      if (done) done.hidden = false;
    });
  });
</script>
<style>
  .cb { border-radius: var(--r-xl); padding: 48px; display: flex; flex-wrap: wrap; align-items: center; gap: 24px 48px; }
  .cb-rose { background: var(--rose); }
  .cb-light { background: var(--milk); }
  .cb-text { flex: 1 1 340px; display: flex; flex-direction: column; gap: 8px; }
  .cb-title { font-family: var(--f-display); font-weight: 500; font-size: clamp(32px, 4vw, 44px); line-height: 1.1; }
  .cb-fields { flex: 1 1 340px; display: flex; flex-direction: column; gap: 12px; }
  .cb-rose .check { color: var(--ink); }
  .cb-rose .check a { color: var(--ink); }
  .cb-done { font-size: 14px; line-height: 20px; background: var(--white); padding: 12px 14px; border-radius: 12px; }
  @media (max-width: 640px) { .cb { padding: 28px 20px; } }
</style>
